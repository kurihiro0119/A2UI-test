{
  "name": "a2ui-tutorial",
  "version": "1.0.0",
  "description": "A2UIチュートリアルアプリ - AIエージェントがUIを生成するデモ",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": [
    "a2ui",
    "ai",
    "agent",
    "tutorial"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
